+# The game's C runtime setjmp / longjmp (T-060). `Com_Error` gets back to the main loop with longjmp; in lifted
+# code that is a jump into the middle of another C function, which only the host's own setjmp / longjmp can do.
+# So a call to the guest's _setjmp3 first arms a host jmp_buf in the calling C function (it has to be in that
+# frame), and the guest's longjmp is replaced by a routine that restores the guest registers the way the
+# original does and then takes the host jump. Helpers: lifted_jmp.h (generated below, self-contained).
+GUEST_SETJMP = 0x00969EAC   # __setjmp3: 13 call sites in 9 functions (re/ghidra_export/calls.csv)
+GUEST_LONGJMP = 0x0096B980  # longjmp
+LIFTED_JMP_H = r"""// GENERATED by tools/lifter/lift.py — do not edit
+// Guest setjmp / longjmp on host setjmp / longjmp (T-060). The guest jmp_buf (MSVC x86): +0 ebp, +4 ebx,
+// +8 edi, +0xC esi, +0x10 esp at entry of _setjmp3 (points at its return address), +0x14 eip, +0x18 the
+// SEH chain head. One host jmp_buf per guest jmp_buf and thread; the tables are weak so that every chunk
+// that needs them can carry this header.
+#pragma once
+#include <setjmp.h>
+typedef struct { uint32_t buf; jmp_buf host; } RtGuestJmp;
+enum { RT_GUEST_JMP_SLOTS = 16 };
+__attribute__((weak)) __thread RtGuestJmp rt_guest_jmp[RT_GUEST_JMP_SLOTS];
+__attribute__((weak)) __thread unsigned rt_guest_jmp_next;
+static inline jmp_buf *rt_guest_jmp_slot(uint32_t buf, int create) {
+    for (unsigned i = 0; i < RT_GUEST_JMP_SLOTS; i++)
+        if (rt_guest_jmp[i].buf == buf) return &rt_guest_jmp[i].host;
+    if (!create) return 0;
+    RtGuestJmp *s = &rt_guest_jmp[rt_guest_jmp_next++ % RT_GUEST_JMP_SLOTS];
+    s->buf = buf;
+    return &s->host;
+}
+// At a call site of _setjmp3, after the return address was pushed: [esp+4] is the guest jmp_buf.
+// 0 = armed, go on and call the guest routine; non-zero = arrived here through rt_guest_longjmp().
+#define RT_GUEST_SETJMP(cpu) setjmp(*rt_guest_jmp_slot(M32((cpu)->esp + 4), 1))
+// Body of the guest's longjmp(buf, value): [esp+4] = buf, [esp+8] = value.
+static inline void rt_guest_longjmp(Cpu *cpu) {
+    uint32_t buf = M32(cpu->esp + 4), value = M32(cpu->esp + 8);
+    jmp_buf *host = rt_guest_jmp_slot(buf, 0);
+    if (!host) rt_trap(cpu, GUEST_LONGJMP_VA, TRAP_NO_TARGET); // longjmp to a buffer no lifted setjmp armed on this thread
+    cpu->ebp = M32(buf);
+    cpu->ebx = M32(buf + 4);
+    cpu->edi = M32(buf + 8);
+    cpu->esi = M32(buf + 0xC);
+    cpu->esp = M32(buf + 0x10) + 4;      // as after the return of _setjmp3
+    M32(cpu->teb) = M32(buf + 0x18);     // SEH chain as it was (no handlers are run: ADR-012)
+    cpu->eax = value ? value : 1;
+    longjmp(*host, 1);
+}
+""".replace("GUEST_LONGJMP_VA", f"0x{GUEST_LONGJMP:08x}u")
+
+
