+    // Pipeline archive (T-068): the compiled code of every pipeline that was created, in one file of the cache
+    // directory. Metal remembers pipelines by itself, but per folder; this file serves any folder. It is written
+    // by a low-priority queue a few seconds after the last new pipeline (and at the end of a replay) — a file
+    // write, never a compile; a pipeline needed while it is being written waits for the write.
+    void open_pipeline_archive() {
+        archive_path_ = cache_dir_ + "/pipelines.metalarchive";
+        archive_mu_ = std::make_shared<std::mutex>();
+        MTLBinaryArchiveDescriptor *d = [MTLBinaryArchiveDescriptor new];
+        if (access(archive_path_.c_str(), R_OK) == 0) {
+            d.url = [NSURL fileURLWithPath:@(archive_path_.c_str())];
+            archive_ = [dev_ newBinaryArchiveWithDescriptor:d error:nil]; // unreadable (another system version): start anew
+        }
+        if (!archive_) {
+            d.url = nil;
+            archive_ = [dev_ newBinaryArchiveWithDescriptor:d error:nil];
+        }
+    }
+    void save_pipeline_archive(bool wait) {
+        if (!archive_ || !archive_unsaved_) return;
+        archive_unsaved_ = 0;
+        id<MTLBinaryArchive> archive = archive_;
+        std::shared_ptr<std::mutex> mu = archive_mu_;
+        std::string path = archive_path_, tmp = archive_path_ + fmt_key(".tmp%d", (int)getpid());
+        void (^write)(void) = ^{
+            std::lock_guard<std::mutex> lk(*mu);
+            NSError *err = nil;
+            if ([archive serializeToURL:[NSURL fileURLWithPath:@(tmp.c_str())] error:&err]) rename(tmp.c_str(), path.c_str());
+            else remove(tmp.c_str());
+        };
+        if (wait) write();
+        else dispatch_async(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), write);
+    }
